+	/*
+	 * lar_disable: the firmware needs a valid MCC of its own.  Without it
+	 * the firmware asserts (NMI_INTERRUPT_UMAC_FATAL in LINK_CONFIG_CMD)
+	 * as soon as an AP/IBSS is started on a 5GHz channel.  The alpha2 the
+	 * user picked with `iw reg set` is not visible to the driver, so it
+	 * must be given with the lar_country module parameter; fall back to
+	 * the ACPI/BIOS MCC when it is not set.
+	 */
+	if (iwlwifi_mod_params.lar_country &&
+	    iwlwifi_mod_params.lar_country[0] >= 'A' &&
+	    iwlwifi_mod_params.lar_country[0] <= 'Z' &&
+	    iwlwifi_mod_params.lar_country[1] >= 'A' &&
+	    iwlwifi_mod_params.lar_country[1] <= 'Z') {
+		kfree(regd);
+		regd = iwl_mvm_get_regdomain(mvm->hw->wiphy,
+					     iwlwifi_mod_params.lar_country,
+					     MCC_SOURCE_BIOS, NULL);
+		if (IS_ERR_OR_NULL(regd))
+			return -EIO;
+	} else if (iwl_mvm_is_wifi_mcc_supported(mvm) &&
+		   !iwl_bios_get_mcc(&mvm->fwrt, mcc)) {
