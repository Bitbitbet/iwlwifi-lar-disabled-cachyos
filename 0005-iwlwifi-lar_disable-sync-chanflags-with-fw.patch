 	if (!iwlwifi_mod_params.lar_disable)
 		retval = regulatory_set_wiphy_regd_sync(mvm->hw->wiphy, regd);
-	else
+	else {
 		retval = 0;
+		iwl_mvm_lar_disable_sync_chanflags(mvm, regd);
+	}
 	kfree(regd);
 	return retval;
 }
